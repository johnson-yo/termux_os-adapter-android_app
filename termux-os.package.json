{
  "schema": "termux-os.package.v1",
  "id": "github.termux-os.adapter.android-app",
  "name": "Android App Adapter",
  "version": "0.1.1",
  "description": "Authenticated Android App API entry with schema-driven settings and opt-in Assistant event routing.",
  "types": [
    "adapter"
  ],
  "compatibility": {
    "framework": ">=0.1.0"
  },
  "entrypoints": {
    "backend": "package.mjs",
    "webui": "web/index.html"
  },
  "admin": {
    "title": "Android App Adapter"
  },
  "verification": {
    "device": {
      "command": "node scripts/verify-device.mjs",
      "timeout_ms": 30000,
      "requires_running": false
    }
  },
  "components": {
    "services": [],
    "actions": [
      "android.app.api.describe"
    ],
    "apps": []
  },
  "capabilities": {
    "provides": [
      {
        "id": "android.app.api",
        "provider": "android-app",
        "kind": "action",
        "action": "android.app.api.describe"
      }
    ],
    "requires": []
  },
  "menu": [
    {
      "parent": "/admin/adapters",
      "path": "/packages/github.termux-os.adapter.android-app/",
      "title": "Android App Adapter",
      "order": 10
    }
  ],
  "runtime": {
    "framework": {
      "commands": [
        "node"
      ]
    },
    "termux_packages": [],
    "bundled": [],
    "external": []
  },
  "states": {
    "provides": [
      {
        "id": "speech.tts",
        "type": "bool",
        "max_age_ms": 60000,
        "description": "The App is speaking right now (observed at 100 ms resolution)"
      },
      {
        "id": "audio.output.route",
        "type": "enum",
        "values": [
          "built_in",
          "bluetooth",
          "wired",
          "usb",
          "unknown"
        ],
        "description": "Actual Android playback route class"
      }
    ]
  }
}
